{
  "name": "img-hosting",
  "version": "0.1.0",
  "private": true,
  "description": "A private, self-hosted image hosting service on Cloudflare Workers with an Imgur-shaped API.",
  "license": "MIT",
  "type": "module",
  "scripts": {
    "dev": "wrangler dev",
    "deploy": "wrangler deploy",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc --noEmit",
    "db:local": "wrangler d1 execute IMG_DB --local --file=./schema.sql",
    "db:remote": "wrangler d1 execute IMG_DB --remote --file=./schema.sql",
    "cf-typegen": "wrangler types"
  },
  "dependencies": {
    "hono": "^4.6.14"
  },
  "devDependencies": {
    "@cloudflare/vitest-pool-workers": "^0.5.40",
    "@cloudflare/workers-types": "^4.20241218.0",
    "typescript": "^5.7.2",
    "vitest": "2.1.8",
    "wrangler": "^4.0.0"
  },
  "engines": {
    "node": ">=20"
  }
}
