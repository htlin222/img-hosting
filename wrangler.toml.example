# =========================================================================
# img-hosting - Cloudflare Workers config (TEMPLATE).
#
# 1. Copy this file to `wrangler.toml` (gitignored).
# 2. Fill in the real `database_id` printed by `wrangler d1 create img-hosting`.
# 3. Secrets (API_KEY) live in `.dev.vars` locally and `wrangler secret` in
#    prod - never in this file.
# =========================================================================

name = "img-hosting"
main = "src/index.ts"
compatibility_date = "2025-01-01"
compatibility_flags = ["nodejs_compat"]

# Public base URL used to build the `link` field in API responses.
# Set this to your custom domain once you've added a route, e.g.
#   PUBLIC_BASE_URL = "https://i.example.com"
# If unset, links fall back to the request origin (workers.dev URL).
[vars]
PUBLIC_BASE_URL = ""
# Cloudflare Access (Zero Trust). Leave blank to disable Access-based auth;
# write endpoints will fall back to bearer-token auth in that case.
#   ACCESS_TEAM = "your-team"                  # the *.cloudflareaccess.com subdomain
#   ACCESS_AUD  = "<application-AUD-tag-uuid>" # from the Access app you create
ACCESS_TEAM = ""
ACCESS_AUD  = ""

# ---- R2 (image bytes) ----
# `bucket_name` must match a bucket you've created via
#   wrangler r2 bucket create <name>
# Rename if you like; the value is not secret.
[[r2_buckets]]
binding = "IMG_BUCKET"
bucket_name = "img-hosting"

# ---- D1 (metadata) ----
# Create with:
#   wrangler d1 create img-hosting
# Then paste the printed `database_id` here. It's a uuid; not a secret per se,
# but we still keep it out of the public repo - operators fill it in locally.
[[d1_databases]]
binding = "IMG_DB"
database_name = "img-hosting"
database_id = ""   # <-- REPLACE with your D1 database_id after `wrangler d1 create`
migrations_dir = "migrations"

# ---- Rate limiting (unsafe binding; namespace_id is per-Worker, not secret) ----
[[unsafe.bindings]]
name = "RL"
type = "ratelimit"
namespace_id = "1001"
simple = { limit = 60, period = 60 }   # 60 requests / 60s per key

# ---- Local dev tweaks ----
[dev]
port = 8787
